<?xml version="1.0" encoding="utf-8"?>
<org.breezyweather.remoteviews.trend.TrendLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_trend_hourly_double"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/BreezyWeatherTheme">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <org.breezyweather.remoteviews.trend.WidgetItemView
            android:id="@+id/widget_trend_hourly_double_item_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <org.breezyweather.remoteviews.trend.WidgetItemView
            android:id="@+id/widget_trend_hourly_double_item_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <org.breezyweather.remoteviews.trend.WidgetItemView
            android:id="@+id/widget_trend_hourly_double_item_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <org.breezyweather.remoteviews.trend.WidgetItemView
            android:id="@+id/widget_trend_hourly_double_item_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <org.breezyweather.remoteviews.trend.WidgetItemView
            android:id="@+id/widget_trend_hourly_double_item_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <org.breezyweather.remoteviews.trend.WidgetItemView
            android:id="@+id/widget_trend_hourly_double_item_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <org.breezyweather.remoteviews.trend.WidgetItemView
            android:id="@+id/widget_trend_hourly_double_item_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <org.breezyweather.remoteviews.trend.WidgetItemView
            android:id="@+id/widget_trend_hourly_double_item_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <org.breezyweather.remoteviews.trend.WidgetItemView
            android:id="@+id/widget_trend_hourly_double_item_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <org.breezyweather.remoteviews.trend.WidgetItemView
            android:id="@+id/widget_trend_hourly_double_item_10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

</org.breezyweather.remoteviews.trend.TrendLinearLayout>
